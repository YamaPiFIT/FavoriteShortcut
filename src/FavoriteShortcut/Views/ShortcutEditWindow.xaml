<Window x:Class="FavoriteShortcut.Views.ShortcutEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FavoriteShortcut.Controls"
        Title="{DynamicResource Str.Edit.TitleNew}" Width="620" SizeToContent="Height"
        MinWidth="520" MaxHeight="900"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{DynamicResource UiFontFamily}">

    <Grid Margin="22,20,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">

            <!-- URL / パス -->
            <TextBlock Text="{DynamicResource Str.Edit.Target}" Style="{StaticResource SectionHeaderText}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TargetBox" Grid.Column="0" FontSize="13.5"
                         TextChanged="OnTargetChanged" />
                <Button Grid.Column="1" Content="{DynamicResource Str.Edit.BrowseFile}" Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0" Click="OnBrowseFile" />
                <Button Grid.Column="2" Content="{DynamicResource Str.Edit.BrowseFolder}" Style="{StaticResource SecondaryButton}"
                        Margin="6,0,0,0" Click="OnBrowseFolder" />
            </Grid>
            <TextBlock x:Name="TargetInfoText" Style="{StaticResource CaptionText}" Margin="2,6,0,0"
                       TextWrapping="Wrap" />

            <!-- タイトル -->
            <TextBlock Text="{DynamicResource Str.Edit.TitleLabel}" Style="{StaticResource SectionHeaderText}" Margin="0,16,0,6" />
            <TextBox x:Name="TitleBox" FontSize="13.5" />

            <!-- タグ -->
            <Grid Margin="0,16,0,6">
                <TextBlock Text="{DynamicResource Str.Tag.Section}" Style="{StaticResource SectionHeaderText}" Margin="0"
                           VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource CaptionText}" HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Text="{DynamicResource Str.Edit.TagHint}" />
            </Grid>
            <controls:TagInputControl x:Name="TagInput" />

            <!-- フォルダ -->
            <TextBlock Text="{DynamicResource Str.Edit.Folder}" Style="{StaticResource SectionHeaderText}" Margin="0,16,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="FolderCombo" Grid.Column="0" />
                <Button Grid.Column="1" Content="{DynamicResource Str.Edit.NewFolder}" Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0" Click="OnNewFolder" />
            </Grid>

            <!-- アイコン -->
            <TextBlock Text="{DynamicResource Str.Edit.Icon}" Style="{StaticResource SectionHeaderText}" Margin="0,16,0,6" />
            <Border Padding="12" CornerRadius="8" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="52" Height="52" CornerRadius="8"
                            Background="{DynamicResource SidebarBackgroundBrush}">
                        <Image x:Name="IconPreview" Width="36" Height="36" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="IconSourceText" Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource Str.Edit.ChooseImage}" Style="{StaticResource SecondaryButton}"
                                    Click="OnChooseIcon" />
                            <Button x:Name="FetchFaviconButton" Content="{DynamicResource Str.Edit.FetchFavicon}"
                                    Style="{StaticResource SecondaryButton}" Margin="6,0,0,0"
                                    Click="OnFetchFavicon" />
                            <Button Content="{DynamicResource Str.Common.ResetDefault}" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                                    Click="OnResetIcon" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- メモ（検索対象にもなる） -->
            <TextBlock Text="{DynamicResource Str.Edit.Note}" Style="{StaticResource SectionHeaderText}"
                       Margin="0,16,0,6" />
            <TextBox x:Name="NoteBox" Height="60" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" Grid.Row="1" Foreground="{DynamicResource DangerBrush}"
                   Margin="2,14,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Button x:Name="DeleteButton" Content="{DynamicResource Str.Common.Delete}" Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Left" Foreground="{DynamicResource DangerBrush}"
                    Visibility="Collapsed" Click="OnDelete" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Str.Common.Cancel}" Style="{StaticResource SecondaryButton}" IsCancel="True" MinWidth="100" />
                <Button x:Name="SaveButton" Content="{DynamicResource Str.Common.Save}" Style="{StaticResource PrimaryButton}"
                        Margin="8,0,0,0" MinWidth="100" IsDefault="True" Click="OnSave" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
