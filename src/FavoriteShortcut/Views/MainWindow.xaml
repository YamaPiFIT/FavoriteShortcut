<Window x:Class="FavoriteShortcut.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:models="clr-namespace:FavoriteShortcut.Models"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="お気に入りショートカット"
        Height="680" Width="1040" MinHeight="460" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="{DynamicResource UiFontFamily}"
        Icon="pack://application:,,,/Assets/app.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- フォルダツリー: 実フォルダ -->
        <HierarchicalDataTemplate DataType="{x:Type models:FolderItem}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <TextBlock Text="📁" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- フォルダツリー: 「すべて」「未分類」 -->
        <DataTemplate DataType="{x:Type models:SpecialFolderNode}">
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <TextBlock Text="{Binding Glyph}" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" />
            </StackPanel>
        </DataTemplate>

        <Style x:Key="FolderTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="Bd" CornerRadius="6" Background="Transparent"
                                    Padding="4,5" Margin="0,0,4,0" SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander" Grid.Column="0" Focusable="False"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press" Cursor="Hand">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" Width="16" Height="16">
                                                    <Path x:Name="Arrow" Data="M0,0 L4,4 L0,8"
                                                          Stroke="{DynamicResource TextSecondaryBrush}"
                                                          StrokeThickness="1.5" StrokeEndLineCap="Round"
                                                          StrokeStartLineCap="Round"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Arrow" Property="Data" Value="M0,0 L8,0 L4,5" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="PART_Header" Grid.Column="1"
                                                      ContentSource="Header" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Margin="14,0,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ショートカット一覧の共通コンテナ -->
        <Style x:Key="ShortcutItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Margin="4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- カード表示 -->
        <DataTemplate x:Key="CardTemplate">
            <Border Width="180" Height="132" CornerRadius="10" Padding="12,14"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Border.ToolTip>
                    <StackPanel MaxWidth="440">
                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Target}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" />
                        <TextBlock Text="{Binding FolderPathText}" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" />
                    </StackPanel>
                </Border.ToolTip>
                <StackPanel>
                    <Image Source="{Binding Icon}" Stretch="Uniform" HorizontalAlignment="Center"
                           Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{Binding DisplayTitle}" HorizontalAlignment="Center"
                               TextAlignment="Center" Margin="0,10,0,0" MaxHeight="36"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TagsText}" HorizontalAlignment="Center" Margin="0,6,0,0"
                               Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- リスト表示 -->
        <DataTemplate x:Key="ListTemplate">
            <Border Padding="10,8" CornerRadius="8"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="{Binding Icon}" Stretch="Uniform" VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Target}" Style="{StaticResource CaptionText}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="280">
                        <TextBlock Text="{Binding TagsText}" Style="{StaticResource CaptionText}"
                                   TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding FolderPathText}" Style="{StaticResource CaptionText}"
                                   TextAlignment="Right" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="CardPanel">
            <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="ListPanel">
            <VirtualizingStackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static ApplicationCommands.Find}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{x:Static ApplicationCommands.New}" />
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Find}" Executed="OnFocusSearch" />
        <CommandBinding Command="{x:Static ApplicationCommands.New}" Executed="OnNewShortcut" />
    </Window.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================================================== ヘッダー -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="お気に入りショートカット" FontSize="14.5" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="2,0,18,0" />

                <Grid Grid.Column="1" MaxWidth="560" HorizontalAlignment="Stretch">
                    <TextBox x:Name="SearchBox" Padding="32,7,30,7" FontSize="13.5"
                             TextChanged="OnSearchTextChanged" PreviewKeyDown="OnSearchKeyDown" />
                    <TextBlock Text="🔍" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock x:Name="SearchPlaceholder" Margin="32,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" Foreground="{DynamicResource TextDisabledBrush}"
                               Text="検索...  （タイトル / タグ / フォルダ / URL・パス）" />
                    <Button x:Name="ClearSearchButton" Style="{StaticResource GhostButton}" Content="✕"
                            HorizontalAlignment="Right" Margin="0,0,4,0" Width="24" Height="24" Padding="0"
                            Visibility="Collapsed" Click="OnClearSearch" ToolTip="検索条件をクリア (Esc)" />
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0">
                    <Border CornerRadius="6" Background="{DynamicResource SidebarBackgroundBrush}"
                            Padding="2" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="CardViewToggle" Style="{StaticResource ViewToggleButton}"
                                          Content="▦ カード" Click="OnViewModeChanged" ToolTip="カード表示" />
                            <ToggleButton x:Name="ListViewToggle" Style="{StaticResource ViewToggleButton}"
                                          Content="☰ リスト" Click="OnViewModeChanged" ToolTip="リスト表示" />
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource PrimaryButton}" Content="＋ 新規登録"
                            Click="OnNewShortcut" ToolTip="新しいショートカットを登録 (Ctrl+N)" />

                    <Button x:Name="MenuButton" Style="{StaticResource SecondaryButton}" Content="⋯"
                            Margin="8,0,0,0" Width="38" Padding="0" Click="OnMenuButtonClick"
                            ToolTip="その他の操作">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="AppMenu">
                                <MenuItem Header="設定..." Click="OnOpenSettings" />
                                <Separator />
                                <MenuItem Header="ブラウザのお気に入りを取り込む..." Click="OnImportBookmarks" />
                                <Separator />
                                <MenuItem Header="エクスポート（ZIP に保存）..." Click="OnExport" />
                                <MenuItem Header="インポート（ZIP から取り込み）..." Click="OnImport" />
                                <Separator />
                                <MenuItem Header="今すぐバックアップを作成" Click="OnBackupNow" />
                                <MenuItem Header="データ保存場所を開く" Click="OnOpenDataFolder" />
                                <Separator />
                                <MenuItem Header="ランチャーを表示" Click="OnShowLauncher" />
                                <MenuItem Header="使い方（README）" Click="OnShowHelp" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================================================== 本体 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FolderPaneColumn" Width="240" MinWidth="170" MaxWidth="460" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- 左: フォルダ & タグ -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="14,12,10,6">
                        <TextBlock Text="フォルダ" Style="{StaticResource SectionHeaderText}"
                                   VerticalAlignment="Center" Margin="0" />
                        <Button Style="{StaticResource GhostButton}" Content="＋" FontSize="14"
                                HorizontalAlignment="Right" Padding="6,0" Click="OnNewFolder"
                                ToolTip="新しいフォルダを作成" />
                    </Grid>

                    <TreeView x:Name="FolderTree" Grid.Row="1" Background="Transparent" BorderThickness="0"
                              Margin="8,0,4,0" Padding="0,0,0,8"
                              ItemContainerStyle="{StaticResource FolderTreeItemStyle}"
                              SelectedItemChanged="OnFolderSelectionChanged"
                              AllowDrop="True"
                              PreviewMouseLeftButtonDown="OnTreePreviewMouseDown"
                              PreviewMouseMove="OnTreePreviewMouseMove"
                              DragOver="OnTreeDragOver"
                              Drop="OnTreeDrop"
                              PreviewMouseRightButtonDown="OnTreeRightButtonDown"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="新しいフォルダ" Click="OnNewFolder" />
                                <MenuItem x:Name="TreeNewSubFolderItem" Header="新しいサブフォルダ" Click="OnNewSubFolder" />
                                <Separator />
                                <MenuItem x:Name="TreeRenameItem" Header="名前変更" InputGestureText="F2" Click="OnRenameFolder" />
                                <MenuItem x:Name="TreeDeleteItem" Header="削除" Click="OnDeleteFolder" />
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>

                    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                            Padding="14,10,10,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="タグ" Style="{StaticResource SectionHeaderText}" Margin="0"
                                           VerticalAlignment="Center" />
                                <Button Style="{StaticResource GhostButton}" Content="管理"
                                        HorizontalAlignment="Right" Padding="6,0" FontSize="11"
                                        Click="OnManageTags" ToolTip="タグの名前変更・削除" />
                            </Grid>
                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="TagCloud">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock x:Name="NoTagsText" Text="タグはまだありません" Style="{StaticResource CaptionText}"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"
                          ResizeBehavior="PreviousAndNext" />

            <!-- 右: ショートカット一覧 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="18,12,18,6">
                    <TextBlock x:Name="ScopeText" Text="すべてのショートカット" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="CountText" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Style="{StaticResource CaptionText}" />
                </Grid>

                <Border x:Name="TruncationNotice" Grid.Row="1" Margin="18,0,18,6" Padding="10,7"
                        CornerRadius="6" Visibility="Collapsed"
                        Background="{DynamicResource AccentSoftBrush}">
                    <TextBlock x:Name="TruncationText" TextWrapping="Wrap" FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>

                <ListBox x:Name="ShortcutList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                         Margin="14,0,8,8" Padding="0,0,0,10"
                         SelectionMode="Extended"
                         ItemContainerStyle="{StaticResource ShortcutItemContainerStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         AllowDrop="True"
                         MouseDoubleClick="OnShortcutDoubleClick"
                         PreviewKeyDown="OnShortcutListKeyDown"
                         PreviewMouseLeftButtonDown="OnListPreviewMouseDown"
                         PreviewMouseMove="OnListPreviewMouseMove"
                         PreviewMouseRightButtonDown="OnListRightButtonDown"
                         DragOver="OnListDragOver"
                         Drop="OnListDrop">
                    <ListBox.ContextMenu>
                        <ContextMenu x:Name="ShortcutMenu">
                            <MenuItem Header="開く" InputGestureText="Enter" Click="OnOpenShortcut" />
                            <MenuItem Header="編集..." InputGestureText="F2" Click="OnEditShortcut" />
                            <Separator />
                            <MenuItem Header="複製" Click="OnDuplicateShortcut" />
                            <MenuItem Header="URL / パスをコピー" InputGestureText="Ctrl+C" Click="OnCopyTarget" />
                            <MenuItem Header="タイトルをコピー" Click="OnCopyTitle" />
                            <MenuItem Header="保存先フォルダを開く" Click="OnRevealInExplorer" />
                            <Separator />
                            <MenuItem Header="アイコンを再取得" Click="OnRefreshIcon" />
                            <MenuItem Header="移動先フォルダ..." Click="OnMoveToFolder" />
                            <Separator />
                            <MenuItem Header="削除" InputGestureText="Delete" Click="OnDeleteShortcut" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>

                <StackPanel x:Name="EmptyState" Grid.Row="2" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Visibility="Collapsed" MaxWidth="420">
                    <TextBlock x:Name="EmptyTitle" Text="ショートカットがありません" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyHint" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,8,0,16"
                               Text="「＋ 新規登録」から追加するか、エクスプローラーからファイル・フォルダをここへドラッグしてください。" />
                    <Button Style="{StaticResource PrimaryButton}" Content="＋ 新規登録"
                            HorizontalAlignment="Center" Click="OnNewShortcut" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ===================================================== ステータスバー -->
        <Border Grid.Row="2" Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <TextBlock x:Name="StatusText" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                <TextBlock x:Name="HotKeyHint" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Style="{StaticResource CaptionText}" />
            </Grid>
        </Border>
    </Grid>
</Window>
