<Window x:Class="FavoriteShortcut.Views.TextInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="入力" SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{DynamicResource UiFontFamily}">
    <StackPanel Margin="20">
        <TextBlock x:Name="LabelText" Style="{StaticResource SectionHeaderText}" />
        <TextBox x:Name="ValueBox" FontSize="14" PreviewKeyDown="OnKeyDown" />
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="11.5"
                   Margin="2,6,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="キャンセル" Style="{StaticResource SecondaryButton}" IsCancel="True" MinWidth="92" />
            <Button Content="OK" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" MinWidth="92"
                    Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
