<Window x:Class="FavoriteShortcut.Views.ImportModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.ImportMode.Title}" SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{DynamicResource UiFontFamily}">
    <StackPanel Margin="22">
        <TextBlock Text="{DynamicResource Str.ImportMode.Heading}" FontSize="15" FontWeight="SemiBold" />

        <Border Margin="0,12,0,0" Padding="14" CornerRadius="8"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="SummaryText" TextWrapping="Wrap" />
                <TextBlock x:Name="ExportedAtText" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <TextBlock Text="{DynamicResource Str.ImportMode.Method}" Style="{StaticResource SectionHeaderText}" Margin="0,18,0,6" />

        <RadioButton x:Name="MergeOption" GroupName="Mode" IsChecked="True">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str.ImportMode.Merge}" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="{DynamicResource Str.ImportMode.MergeNote}" />
            </StackPanel>
        </RadioButton>

        <RadioButton x:Name="ReplaceOption" GroupName="Mode" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str.ImportMode.Replace}" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="{DynamicResource Str.ImportMode.ReplaceNote}" />
            </StackPanel>
        </RadioButton>

        <Border Margin="0,16,0,0" Padding="12,10" CornerRadius="6"
                Background="{DynamicResource AccentSoftBrush}">
            <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{DynamicResource Str.ImportMode.BackupNote}" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{DynamicResource Str.Common.Cancel}" Style="{StaticResource SecondaryButton}" IsCancel="True" MinWidth="100" />
            <Button Content="{DynamicResource Str.ImportMode.Title}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" MinWidth="100"
                    Click="OnImport" />
        </StackPanel>
    </StackPanel>
</Window>
