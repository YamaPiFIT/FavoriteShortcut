<Window x:Class="FavoriteShortcut.Views.ImportModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="インポート" SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{DynamicResource UiFontFamily}">
    <StackPanel Margin="22">
        <TextBlock Text="このデータを取り込みます" FontSize="15" FontWeight="SemiBold" />

        <Border Margin="0,12,0,0" Padding="14" CornerRadius="8"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="SummaryText" TextWrapping="Wrap" />
                <TextBlock x:Name="ExportedAtText" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <TextBlock Text="取り込み方法" Style="{StaticResource SectionHeaderText}" Margin="0,18,0,6" />

        <RadioButton x:Name="MergeOption" GroupName="Mode" IsChecked="True">
            <StackPanel>
                <TextBlock Text="現在のデータを残して追加する" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="同じ構成のフォルダはまとめられ、まったく同じ内容のショートカットは追加されません。" />
            </StackPanel>
        </RadioButton>

        <RadioButton x:Name="ReplaceOption" GroupName="Mode" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="現在のデータをすべて置き換える" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="今このPCにあるフォルダ・ショートカット・タグ・設定は削除され、取り込んだ内容に入れ替わります。" />
            </StackPanel>
        </RadioButton>

        <Border Margin="0,16,0,0" Padding="12,10" CornerRadius="6"
                Background="{DynamicResource AccentSoftBrush}">
            <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="取り込みの直前に、現在のデータのバックアップを自動で作成します。うまくいかなかった場合はそこから戻せます。" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="キャンセル" Style="{StaticResource SecondaryButton}" IsCancel="True" MinWidth="100" />
            <Button Content="インポート" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" MinWidth="100"
                    Click="OnImport" />
        </StackPanel>
    </StackPanel>
</Window>
