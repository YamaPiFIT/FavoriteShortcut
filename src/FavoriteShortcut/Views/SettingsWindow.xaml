<Window x:Class="FavoriteShortcut.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" Width="620" Height="700" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{DynamicResource UiFontFamily}">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="20,18,16,0">
            <StackPanel>

                <!-- 表示 -->
                <TextBlock Text="表示" Style="{StaticResource SectionHeaderText}" />
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="テーマ" Style="{StaticResource RowLabel}" />
                        <ComboBox x:Name="ThemeCombo" Grid.Row="0" Grid.Column="1"
                                  SelectionChanged="OnThemeChanged">
                            <ComboBoxItem Content="ライト" />
                            <ComboBoxItem Content="ダーク" />
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="一覧の表示形式"
                                   Style="{StaticResource RowLabel}" Margin="0,12,12,0" />
                        <ComboBox x:Name="ViewModeCombo" Grid.Row="1" Grid.Column="1" Margin="0,12,0,0">
                            <ComboBoxItem Content="カード表示" />
                            <ComboBoxItem Content="リスト表示" />
                        </ComboBox>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="アイコンサイズ"
                                   Style="{StaticResource RowLabel}" Margin="0,12,12,0" />
                        <ComboBox x:Name="IconSizeCombo" Grid.Row="2" Grid.Column="1" Margin="0,12,0,0">
                            <ComboBoxItem Content="小 (24px)" Tag="24" />
                            <ComboBoxItem Content="標準 (32px)" Tag="32" />
                            <ComboBoxItem Content="大 (48px)" Tag="48" />
                            <ComboBoxItem Content="特大 (64px)" Tag="64" />
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- ランチャー -->
                <TextBlock Text="ランチャー" Style="{StaticResource SectionHeaderText}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="呼び出しキー" Style="{StaticResource RowLabel}" />
                            <Border Grid.Column="1" CornerRadius="6" MinHeight="32"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                                <TextBlock x:Name="HotKeyText" VerticalAlignment="Center" Margin="10,0"
                                           FontWeight="SemiBold" />
                            </Border>
                            <Button x:Name="CaptureButton" Grid.Column="2" Content="変更"
                                    Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Click="OnCaptureHotKey" MinWidth="80" />
                        </Grid>

                        <TextBlock x:Name="HotKeyStatus" Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="150,8,0,0" />

                        <CheckBox x:Name="ShowRecentCheck" Margin="0,14,0,0"
                                  Content="検索欄が空のときに「最近使った項目」を表示する" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="最大表示件数" Style="{StaticResource RowLabel}" />
                            <ComboBox x:Name="MaxResultsCombo" Grid.Column="1">
                                <ComboBoxItem Content="6 件" Tag="6" />
                                <ComboBoxItem Content="8 件" Tag="8" />
                                <ComboBoxItem Content="12 件" Tag="12" />
                                <ComboBoxItem Content="20 件" Tag="20" />
                                <ComboBoxItem Content="30 件" Tag="30" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 起動と常駐 -->
                <TextBlock Text="起動と常駐" Style="{StaticResource SectionHeaderText}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="MinimizeToTrayCheck"
                                  Content="ウィンドウを閉じても終了せず、タスクトレイに常駐する" />
                        <TextBlock Style="{StaticResource CaptionText}" Margin="25,4,0,0" TextWrapping="Wrap"
                                   Text="常駐しているあいだは、他のアプリを使っていてもホットキーでランチャーを呼び出せます。完全に終了するにはトレイアイコンの「終了」を使います。" />

                        <CheckBox x:Name="StartMinimizedCheck" Margin="0,14,0,0"
                                  Content="起動時はウィンドウを表示せず、トレイ常駐で始める" />

                        <CheckBox x:Name="RunAtStartupCheck" Margin="0,14,0,0"
                                  Content="Windows へのサインイン時に自動起動する" />
                        <TextBlock x:Name="StartupStatus" Style="{StaticResource CaptionText}"
                                   Margin="25,4,0,0" TextWrapping="Wrap" />

                        <CheckBox x:Name="RestoreFolderCheck" Margin="0,14,0,0"
                                  Content="次回起動時に、最後に開いていたフォルダを選択する" />
                    </StackPanel>
                </Border>

                <!-- アイコン -->
                <TextBlock Text="アイコン" Style="{StaticResource SectionHeaderText}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="FaviconFallbackCheck"
                                  Content="サイトから favicon を取得できないとき、外部のアイコン取得サービスを使う" />
                        <TextBlock Style="{StaticResource CaptionText}" Margin="25,4,0,0" TextWrapping="Wrap"
                                   Text="有効にすると、取得できなかったサイトのドメイン名が Google のアイコンサービスへ送信されます。既定では無効です。" />

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="未使用のアイコンを整理" Style="{StaticResource SecondaryButton}"
                                    Click="OnCleanIcons" />
                            <TextBlock x:Name="CleanIconsResult" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- データ -->
                <TextBlock Text="データ" Style="{StaticResource SectionHeaderText}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="保存場所" Style="{StaticResource RowLabel}" Margin="0,0,0,6" />
                        <Border CornerRadius="6" Padding="10,8"
                                Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <TextBlock x:Name="DataPathText" TextWrapping="Wrap" FontSize="12" />
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="フォルダを開く" Style="{StaticResource SecondaryButton}"
                                    Click="OnOpenDataFolder" />
                            <Button Content="保存場所を変更..." Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0" Click="OnChangeDataFolder" />
                            <Button Content="既定に戻す" Style="{StaticResource GhostButton}"
                                    Margin="8,0,0,0" Click="OnResetDataFolder" />
                        </StackPanel>
                        <TextBlock x:Name="DataPathNote" Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,14" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="バックアップフォルダを開く" Style="{StaticResource SecondaryButton}"
                                    Click="OnOpenBackupFolder" />
                            <Button Content="ログを開く" Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0" Click="OnOpenLog" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 情報 -->
                <TextBlock Text="このアプリについて" Style="{StaticResource SectionHeaderText}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="VersionText" />
                        <TextBlock x:Name="StatsText" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="キャンセル" Style="{StaticResource SecondaryButton}" IsCancel="True" MinWidth="100" />
                <Button Content="保存" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" MinWidth="100"
                        Click="OnSave" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
