<Window x:Class="FavoriteShortcut.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.Settings.Title}" Width="620" Height="700" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{DynamicResource UiFontFamily}">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="20,18,16,0">
            <StackPanel>

                <!-- 表示 -->
                <TextBlock Text="{DynamicResource Str.Settings.Display}" Style="{StaticResource SectionHeaderText}" />
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 言語。「日本語」「English」は常にその言語自身の表記で出し、
                             誤って切り替えても元に戻せるようにする -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Str.Settings.Language}"
                                   Style="{StaticResource RowLabel}" />
                        <ComboBox x:Name="LanguageCombo" Grid.Row="0" Grid.Column="1"
                                  SelectionChanged="OnLanguageChanged">
                            <ComboBoxItem Content="{DynamicResource Str.Settings.LanguageAuto}" Tag="0" />
                            <ComboBoxItem Content="日本語" Tag="1" />
                            <ComboBoxItem Content="English" Tag="2" />
                        </ComboBox>
                        <TextBlock x:Name="LanguageNote" Grid.Row="1" Grid.Column="1"
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="2,6,0,0" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Str.Settings.Theme}"
                                   Style="{StaticResource RowLabel}" Margin="0,12,12,0" />
                        <ComboBox x:Name="ThemeCombo" Grid.Row="2" Grid.Column="1" Margin="0,12,0,0"
                                  SelectionChanged="OnThemeChanged">
                            <ComboBoxItem Content="{DynamicResource Str.Settings.ThemeLight}" />
                            <ComboBoxItem Content="{DynamicResource Str.Settings.ThemeDark}" />
                        </ComboBox>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Str.Settings.ViewMode}"
                                   Style="{StaticResource RowLabel}" Margin="0,12,12,0" />
                        <ComboBox x:Name="ViewModeCombo" Grid.Row="3" Grid.Column="1" Margin="0,12,0,0">
                            <ComboBoxItem Content="{DynamicResource Str.Main.CardViewTooltip}" />
                            <ComboBoxItem Content="{DynamicResource Str.Main.ListViewTooltip}" />
                        </ComboBox>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Str.Settings.IconSize}"
                                   Style="{StaticResource RowLabel}" Margin="0,12,12,0" />
                        <ComboBox x:Name="IconSizeCombo" Grid.Row="4" Grid.Column="1" Margin="0,12,0,0">
                            <ComboBoxItem Content="{DynamicResource Str.Settings.IconSmall}" Tag="24" />
                            <ComboBoxItem Content="{DynamicResource Str.Settings.IconNormal}" Tag="32" />
                            <ComboBoxItem Content="{DynamicResource Str.Settings.IconLarge}" Tag="48" />
                            <ComboBoxItem Content="{DynamicResource Str.Settings.IconXLarge}" Tag="64" />
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- ランチャー -->
                <TextBlock Text="{DynamicResource Str.Settings.Launcher}" Style="{StaticResource SectionHeaderText}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Str.Settings.HotKey}" Style="{StaticResource RowLabel}" />
                            <Border Grid.Column="1" CornerRadius="6" MinHeight="32"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                                <TextBlock x:Name="HotKeyText" VerticalAlignment="Center" Margin="10,0"
                                           FontWeight="SemiBold" />
                            </Border>
                            <Button x:Name="CaptureButton" Grid.Column="2" Content="{DynamicResource Str.Settings.Change}"
                                    Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Click="OnCaptureHotKey" MinWidth="80" />
                        </Grid>

                        <TextBlock x:Name="HotKeyStatus" Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="150,8,0,0" />

                        <CheckBox x:Name="ShowRecentCheck" Margin="0,14,0,0"
                                  Content="{DynamicResource Str.Settings.ShowRecent}" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Str.Settings.MaxResults}" Style="{StaticResource RowLabel}" />
                            <!-- 「6 件」のような件数表記は言語で形が変わるので、項目はコードで作る -->
                            <ComboBox x:Name="MaxResultsCombo" Grid.Column="1" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 起動と常駐 -->
                <TextBlock Text="{DynamicResource Str.Settings.Startup}" Style="{StaticResource SectionHeaderText}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="MinimizeToTrayCheck"
                                  Content="{DynamicResource Str.Settings.MinimizeToTray}" />
                        <TextBlock Style="{StaticResource CaptionText}" Margin="25,4,0,0" TextWrapping="Wrap"
                                   Text="{DynamicResource Str.Settings.MinimizeToTrayNote}" />

                        <CheckBox x:Name="StartMinimizedCheck" Margin="0,14,0,0"
                                  Content="{DynamicResource Str.Settings.StartMinimized}" />

                        <CheckBox x:Name="RunAtStartupCheck" Margin="0,14,0,0"
                                  Content="{DynamicResource Str.Settings.RunAtStartup}" />
                        <TextBlock x:Name="StartupStatus" Style="{StaticResource CaptionText}"
                                   Margin="25,4,0,0" TextWrapping="Wrap" />

                        <CheckBox x:Name="RestoreFolderCheck" Margin="0,14,0,0"
                                  Content="{DynamicResource Str.Settings.RestoreFolder}" />
                    </StackPanel>
                </Border>

                <!-- アイコン -->
                <TextBlock Text="{DynamicResource Str.Settings.Icons}" Style="{StaticResource SectionHeaderText}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="BrowserIconCacheCheck"
                                  Content="{DynamicResource Str.Settings.BrowserIconCache}" />
                        <TextBlock Style="{StaticResource CaptionText}" Margin="25,4,0,0" TextWrapping="Wrap"
                                   Text="{DynamicResource Str.Settings.BrowserIconCacheNote}" />
                        <TextBlock x:Name="BrowserIconCacheDetected" Style="{StaticResource CaptionText}"
                                   Margin="25,6,0,0" TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="{DynamicResource Str.Settings.CleanIcons}" Style="{StaticResource SecondaryButton}"
                                    Click="OnCleanIcons" />
                            <TextBlock x:Name="CleanIconsResult" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- データ -->
                <TextBlock Text="{DynamicResource Str.Settings.Data}" Style="{StaticResource SectionHeaderText}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.Settings.DataLocation}" Style="{StaticResource RowLabel}" Margin="0,0,0,6" />
                        <Border CornerRadius="6" Padding="10,8"
                                Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <TextBlock x:Name="DataPathText" TextWrapping="Wrap" FontSize="12" />
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="{DynamicResource Str.Settings.OpenFolder}" Style="{StaticResource SecondaryButton}"
                                    Click="OnOpenDataFolder" />
                            <Button Content="{DynamicResource Str.Settings.ChangeLocation}" Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0" Click="OnChangeDataFolder" />
                            <Button Content="{DynamicResource Str.Common.ResetDefault}" Style="{StaticResource GhostButton}"
                                    Margin="8,0,0,0" Click="OnResetDataFolder" />
                        </StackPanel>
                        <TextBlock x:Name="DataPathNote" Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,14" />

                        <CheckBox x:Name="AutoBackupCheck" Content="{DynamicResource Str.Settings.AutoBackup}" />
                        <TextBlock x:Name="AutoBackupNote" Style="{StaticResource CaptionText}"
                                   Margin="25,4,0,0" TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="{DynamicResource Str.Settings.OpenBackup}" Style="{StaticResource SecondaryButton}"
                                    Click="OnOpenBackupFolder" />
                            <Button Content="{DynamicResource Str.Settings.OpenLog}" Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0" Click="OnOpenLog" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 情報 -->
                <TextBlock Text="{DynamicResource Str.Settings.About}" Style="{StaticResource SectionHeaderText}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="VersionText" />
                        <TextBlock x:Name="StatsText" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Str.Common.Cancel}" Style="{StaticResource SecondaryButton}" IsCancel="True" MinWidth="100" />
                <Button Content="{DynamicResource Str.Common.Save}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" MinWidth="100"
                        Click="OnSave" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
