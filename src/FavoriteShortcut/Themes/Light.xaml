<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ライトテーマの配色。キー名は Dark.xaml と必ず一致させること。 -->

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F6F7F9" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#EDEFF3" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F0F3F8" />
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="#E3EBFB" />

    <SolidColorBrush x:Key="BorderBrush" Color="#DDE1E8" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#C4CAD4" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1F27" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#68707E" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#A3AAB6" />

    <SolidColorBrush x:Key="AccentBrush" Color="#3B5BDB" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2F4BC4" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E4EAFC" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TagBackgroundBrush" Color="#E8ECF5" />
    <SolidColorBrush x:Key="TagForegroundBrush" Color="#414B5E" />

    <SolidColorBrush x:Key="DangerBrush" Color="#D6336C" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E8590C" />

    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C2C8D2" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#A2AAB8" />

    <Color x:Key="ShadowColor">#33000000</Color>

</ResourceDictionary>
