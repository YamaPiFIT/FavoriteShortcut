<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>FavoriteShortcut</AssemblyName>
    <RootNamespace>FavoriteShortcut</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <AssemblyTitle>お気に入りショートカット</AssemblyTitle>
    <Product>お気に入りショートカット</Product>
    <Company>YamaPiFIT</Company>
    <Authors>YamaPiFIT</Authors>
    <Copyright>Copyright (c) 2026 YamaPiFIT - MIT License</Copyright>
    <Description>Web サイト・フォルダ・ファイルへのショートカットを整理して、ホットキーで素早く開くランチャー</Description>
    <NeutralLanguage>ja-JP</NeutralLanguage>
    <SatelliteResourceLanguages>ja-JP;en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFAC010: WinForms 用の高DPI警告。本アプリは WPF なので app.manifest 側で指定する。 -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
  </ItemGroup>

  <!-- WinForms is only used for the tray icon; keep its implicit global using out
       of the way so "Application" etc. unambiguously mean the WPF types. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!-- 配布物に README を同梱し、アプリの「使い方」メニューから開けるようにする -->
  <ItemGroup>
    <None Include="..\..\README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
